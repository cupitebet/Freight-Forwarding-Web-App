{
  "name": "freight-forwarding-web-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm start -w @ff/api",
    "migrate": "npm run migrate -w @ff/api",
    "demo": "npm run demo -w @ff/deadline-alarm"
  }
}
