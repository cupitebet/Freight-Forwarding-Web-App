# Salin ke .env. Jangan commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ff:ff@localhost:5432/ff

# API key dipisah koma, minimal 24 karakter. Buat dengan: openssl rand -hex 24
API_KEYS=

# Scheduler alarm
ALARM_ENABLED=true
ALARM_TICK_SECONDS=300

# Webhook n8n yang meneruskan alarm ke WhatsApp/Slack. Kosong = alarm hanya ke log (dilarang di production).
N8N_ALARM_WEBHOOK_URL=
# Secret HMAC bersama dengan n8n, minimal 32 karakter: openssl rand -hex 32
ALARM_WEBHOOK_SECRET=

# true = jalankan migrasi saat start (dev/single-instance). Production: jalankan `npm run migrate -w @ff/api` saat deploy.
MIGRATE_ON_START=false
