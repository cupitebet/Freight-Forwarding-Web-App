# Salin ke .env (scripts/setup-local.ps1 melakukannya otomatis). Jangan commit .env.
# Dibaca otomatis oleh `npm start`, `npm run migrate`, dan `npm test`.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ff:ff@localhost:5432/ff
# Database khusus test e2e (ISINYA DIHAPUS setiap test). Nama wajib berakhiran _test.
TEST_DATABASE_URL=postgres://ff:ff@localhost:5432/ff_test

# API key dipisah koma, minimal 24 karakter. Buat dengan: openssl rand -hex 24
API_KEYS=

# Scheduler alarm
ALARM_ENABLED=true
ALARM_TICK_SECONDS=300

# Opsional. Kosong = alarm log-only: tetap dihitung & tercatat di tabel deadline_alarm_sent,
# bisa dibaca lewat GET /alarms, hanya belum diteruskan ke kanal eksternal.
# Isi kapan pun ada kanal yang siap menerima POST JSON+HMAC (n8n, Slack, WhatsApp Cloud API, dst).
ALARM_WEBHOOK_URL=
# Secret HMAC bersama penerima webhook, minimal 32 karakter: openssl rand -hex 32
ALARM_WEBHOOK_SECRET=

# true = jalankan migrasi saat start (dev/single-instance). Production: jalankan `npm run migrate -w @ff/api` saat deploy.
MIGRATE_ON_START=false
